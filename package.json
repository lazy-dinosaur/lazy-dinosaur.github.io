{
  "name": "my-blog",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev --turbopack",
    "build": "node scripts/build-projects.js && next build && touch out/.nojekyll && node scripts/generate-sitemap.js && node scripts/generate-og-image.js && cp public/robots.txt out/ && cp public/og-image.svg out/",
    "start": "next start",
    "lint": "next lint",
    "sync": "scripts/sync-notes.py",
    "deploy": "bun run sync && bun run build && gh-pages -d out -b gh-pages",
    "post": "bun run sync && git add . && git commit -m 'update post' && git push",
    "serve": "bunx serve@latest out",
    "generate-sitemap": "node scripts/generate-sitemap.js",
    "build-projects": "node scripts/build-projects.js"
  },
  "dependencies": {
    "@r4ai/remark-callout": "^0.6.2",
    "@radix-ui/react-accordion": "^1.2.3",
    "@radix-ui/react-collapsible": "^1.1.3",
    "@radix-ui/react-dialog": "^1.1.6",
    "@radix-ui/react-navigation-menu": "^1.2.5",
    "@radix-ui/react-scroll-area": "^1.2.3",
    "@radix-ui/react-separator": "^1.1.2",
    "@radix-ui/react-slot": "^1.1.2",
    "@radix-ui/react-tooltip": "^1.1.8",
    "@tanstack/react-query": "^5.66.11",
    "@types/react-syntax-highlighter": "^15.5.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "1.0.0",
    "date-fns": "^3.3.1",
    "es-hangul": "^2.3.1",
    "framer-motion": "^12.4.11",
    "gray-matter": "^4.0.3",
    "install": "^0.13.0",
    "lucide-react": "^0.477.0",
    "mermaid": "^11.6.0",
    "next": "15.1.7",
    "next-export-optimize-images": "^4.6.1",
    "next-themes": "^0.4.4",
    "npm": "^11.2.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.0.0",
    "react-syntax-highlighter": "^15.6.1",
    "remark-gfm": "^4.0.1",
    "remark-rehype": "^11.1.1",
    "swiper": "^11.2.5",
    "tailwind-merge": "^3.0.2",
    "tailwindcss-animate": "^1.0.7",
    "tailwindcss-animated": "^2.0.0",
    "vercel": "^41.3.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.0",
    "@tailwindcss/typography": "^0.5.16",
    "@types/node": "^20.17.19",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "eslint": "^9.21.0",
    "eslint-config-next": "15.1.7",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  }
}
